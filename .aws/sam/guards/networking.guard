# Enforces project constraints defined in:
#   - AWS Well-Architected Framework (network security best practices)
#   - AWS Well-Architected Framework (SEC 5 — protect networks)

# Rule: EC2 subnets MUST NOT map public IPs on launch.
# All project subnets are private; no resource MUST be directly reachable from the public internet.
rule subnet_no_public_ip {
    let subnets = Resources.*[ Type == "AWS::EC2::Subnet" ]

    when %subnets !empty {
        %subnets.Properties.MapPublicIpOnLaunch == false
        <<
            Violation: AWS::EC2::Subnet MUST NOT map public IP addresses on launch.
            All project subnets MUST be private. MapPublicIpOnLaunch MUST be false.
        >>
    }
}

# Rule: VPCs MUST have DNS support and DNS hostname resolution enabled.
# Required for private endpoint connectivity and AWS service name resolution.
# Source: AWS Well-Architected Framework.
rule vpc_dns_enabled {
    let vpcs = Resources.*[ Type == "AWS::EC2::VPC" ]

    when %vpcs !empty {
        %vpcs.Properties.EnableDnsSupport == true
        <<
            Violation: AWS::EC2::VPC MUST have EnableDnsSupport set to true.
            DNS support MUST be enabled for VPC endpoint and service name resolution.
        >>

        %vpcs.Properties.EnableDnsHostnames == true
        <<
            Violation: AWS::EC2::VPC MUST have EnableDnsHostnames set to true.
            DNS hostname resolution MUST be enabled for internal service discovery.
        >>
    }
}

# Rule: Every ingress and egress rule in a Security Group MUST have a Description field.
# This aligns with cfn_nag W36 and ensures all rules are self-documenting for audit and change management.
# Source: cfn_nag W36 pattern; AWS Well-Architected Framework (SEC 6).
rule security_group_rules_have_description {
    let security_groups = Resources.*[ Type == "AWS::EC2::SecurityGroup" ]

    when %security_groups !empty {
        when %security_groups.Properties.SecurityGroupIngress exists {
            %security_groups.Properties.SecurityGroupIngress[*].Description exists
            <<
                Violation: Every SecurityGroupIngress rule MUST have a Description.
                A Description MUST be added to each ingress rule for audit traceability.
            >>
        }

        when %security_groups.Properties.SecurityGroupEgress exists {
            %security_groups.Properties.SecurityGroupEgress[*].Description exists
            <<
                Violation: Every SecurityGroupEgress rule MUST have a Description.
                A Description MUST be added to each egress rule for audit traceability.
            >>
        }
    }
}

# Rule: Standalone security group rule resources MUST include a Description.
# Source: cfn_nag W36 pattern; AWS Well-Architected Framework (SEC 6).
rule security_group_rule_resources_have_description {
    let ingress_rules = Resources.*[ Type == "AWS::EC2::SecurityGroupIngress" ]
    let egress_rules = Resources.*[ Type == "AWS::EC2::SecurityGroupEgress" ]

    when %ingress_rules !empty {
        %ingress_rules.Properties.Description exists
        <<
            Violation: AWS::EC2::SecurityGroupIngress resource MUST have a Description.
            A Description MUST be added for audit traceability.
        >>
    }

    when %egress_rules !empty {
        %egress_rules.Properties.Description exists
        <<
            Violation: AWS::EC2::SecurityGroupEgress resource MUST have a Description.
            A Description MUST be added for audit traceability.
        >>
    }
}

# Rule: Every DMS endpoint MUST be encrypted with KMS according to endpoint type.
rule dms_endpoint_kms_encryption_required {
    let oracle_source_endpoints = Resources.*[
        Type == "AWS::DMS::Endpoint"
        Properties.EngineName == "oracle"
        Properties.EndpointType == "source"
    ]

    let s3_target_endpoints = Resources.*[
        Type == "AWS::DMS::Endpoint"
        Properties.EngineName == "s3"
        Properties.EndpointType == "target"
    ]

    when %oracle_source_endpoints !empty {
        %oracle_source_endpoints.Properties.KmsKeyId exists
        <<
            Violation: Oracle source AWS::DMS::Endpoint MUST define KmsKeyId.
            Source endpoint metadata MUST be encrypted with a customer-managed KMS key.
        >>
    }

    when %s3_target_endpoints !empty {
        %s3_target_endpoints.Properties.S3Settings.EncryptionMode == "SSE_KMS"
        <<
            Violation: S3 target AWS::DMS::Endpoint MUST set S3Settings.EncryptionMode to SSE_KMS.
        >>

        %s3_target_endpoints.Properties.S3Settings.ServerSideEncryptionKmsKeyId exists
        <<
            Violation: S3 target AWS::DMS::Endpoint MUST set S3Settings.ServerSideEncryptionKmsKeyId.
        >>
    }
}

# Rule: Every DMS replication instance MUST NOT be publicly accessible.
# The DMS replication instance operates within private VPC subnets and MUST NOT be reachable from the public internet.
# Source: AWS Well-Architected Framework (SEC 5).
rule dms_replication_instance_not_publicly_accessible {
    let dms_instances = Resources.*[ Type == "AWS::DMS::ReplicationInstance" ]

    when %dms_instances !empty {
        %dms_instances.Properties.PubliclyAccessible == false
        <<
            Violation: AWS::DMS::ReplicationInstance MUST have PubliclyAccessible set to false.
            The DMS replication instance MUST NOT be reachable from the public internet.
            All connectivity MUST flow through the private VPC subnets.
            See AWS Well-Architected Framework (SEC 5).
        >>
    }
}

# Rule: Every interface-type VPC endpoint MUST have private DNS enabled.
# Private DNS ensures that AWS service hostnames (KMS, Secrets Manager, etc.) resolve to private IP addresses within the
# VPC. Without it, SDK calls fall back to public endpoints, bypassing the private network path entirely.
#
# Exception: endpoints that set PrivateDnsEnabled to false for multi-variant coexistence (e.g., SNS) are intentionally excluded
# from this rule by the guard filter below. Where such endpoints are used, they should document the reason in template comments
# or metadata.
# Source: AWS Well-Architected Framework (SEC 5).
rule vpc_interface_endpoint_private_dns_enabled {
    let interface_endpoints = Resources.*[
        Type == "AWS::EC2::VPCEndpoint"
        Properties.VpcEndpointType == "Interface"
        Properties.PrivateDnsEnabled != false
    ]

    when %interface_endpoints !empty {
        %interface_endpoints.Properties.PrivateDnsEnabled == true
        <<
            Violation: AWS::EC2::VPCEndpoint with VpcEndpointType Interface MUST have
            PrivateDnsEnabled set to true. Private DNS MUST be enabled so that service
            endpoints (KMS, Secrets Manager) resolve to private IP addresses within the VPC.
            Without this, SDK calls fall back to public endpoints.
            If PrivateDnsEnabled is intentionally false (multi-variant coexistence), add
            Metadata.cfn_nag.rules_to_suppress.
            See AWS Well-Architected Framework (SEC 5).
        >>
    }
}
