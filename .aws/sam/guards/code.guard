# Mandates that all code and logic (Lambda/SAM/SFN) be referenced as single-line local filesystem paths.

# 1. Standard AWS Lambda Functions.
rule enforce_standard_lambda_local_path {
    let lambda_functions = Resources.*[ Type == 'AWS::Lambda::Function' ]

    when %lambda_functions !empty {
        %lambda_functions.Properties {
            Code is_string
            << message: [FAILED] AWS::Lambda::Function 'Code' must be a single-line path string. Objects/ZipFile are forbidden. >>

            Code == /^[^\r\n]*$/
            << message: [FAILED] AWS::Lambda::Function 'Code' contains newlines. Use a simple path. >>

            Code != ""
            << message: [FAILED] AWS::Lambda::Function 'Code' path cannot be empty. >>
        }
    }
}

# 2. AWS SAM Serverless Functions.
rule enforce_sam_lambda_local_path {
    let sam_functions = Resources.*[ Type == 'AWS::Serverless::Function' ]

    when %sam_functions !empty {
        %sam_functions.Properties {
            CodeUri is_string
            << message: [FAILED] AWS::Serverless::Function 'CodeUri' must be a single-line path string. >>

            CodeUri == /^[^\r\n]*$/
            << message: [FAILED] AWS::Serverless::Function 'CodeUri' contains newlines. >>

            CodeUri != ""
            << message: [FAILED] AWS::Serverless::Function 'CodeUri' path cannot be empty. >>

            InlineCode not exists
            << message: [FAILED] AWS::Serverless::Function 'InlineCode' is strictly forbidden. >>
        }
    }
}

# 3. AWS SAM State Machines.
rule enforce_external_sam_sfn_definition {
    let sam_state_machines = Resources.*[ Type == 'AWS::Serverless::StateMachine' ]

    when %sam_state_machines !empty {
        %sam_state_machines.Properties {
            Definition not exists
            << message: [FAILED] Inline 'Definition' is forbidden. Move logic to a separate JSON/ASL file. >>

            DefinitionUri exists
            DefinitionUri is_string
            DefinitionUri == /^[^\r\n]*$/
            << message: [FAILED] 'DefinitionUri' must be a single-line path string. >>

            DefinitionUri != ""
            << message: [FAILED] 'DefinitionUri' path cannot be empty. >>
        }
    }
}
